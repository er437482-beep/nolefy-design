# ===== SUPABASE =====
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anonima-aqui

# ===== BACKEND (NUNCA envie service_role ao frontend) =====
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-aqui
SUPABASE_URL=https://seu-projeto.supabase.co

# ===== AUTENTICAÇÃO =====
JWT_SECRET=sua-chave-jwt-super-segura-gerada-com-crypto-32-chars-minimo
SESSION_EXPIRY=86400000

# ===== ENVIRONMENT =====
NODE_ENV=production
VITE_APP_URL=https://nolefy-design.vercel.app

# ===== SEGURANÇA =====
ALLOWED_ORIGINS=https://nolefy-design.vercel.app,https://www.nolefy-design.vercel.app
MAX_UPLOAD_SIZE=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/svg+xml
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=5
